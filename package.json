  "bugs": {
    "url": "https://github.com/alex-o-748/tf-source-fetcher/issues"
  },
  "homepage": "https://github.com/alex-o-748/tf-source-fetcher#readme",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ioredis": "^6.0.0",
    "jsdom": "^30.0.1",
    "robots-parser": "^3.0.1",
    "unpdf": "^1.8.0"
  }
}
